# SMTP (used by nodemailer; server-side only, never prefix with NEXT_PUBLIC_)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (must be verified with your SMTP provider) and the display name shown next to it.
# SMTP_FROM may also be a full "Name <address>" string, in which case SMTP_FROM_NAME is ignored.
SMTP_FROM=hello@example.com
SMTP_FROM_NAME=Petcovered
# Where new-application notifications go. Comma-separate to notify several people.
SMTP_TO=team@example.com

# Google Gemini key for the AI chat assistant (read by app/api/chat/route.ts; server-side only)
API_KEY=
